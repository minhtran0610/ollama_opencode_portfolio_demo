---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
}

const { title = "Minh Tran — Machine Learning Engineer" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <meta name="description" content="Minh Tran — Machine Learning Engineer, Vaisala Xweather. Espoo, Finland." />
  </head>
  <body>
    <Header />
    <main class="content">
      <slot />
    </main>

    <p class="slide-counter" aria-hidden="true">
      <span class="slide-counter-current">01</span><span>/07</span>
    </p>

    <script src="../scripts/reveal.js"></script>
  </body>
</html>

---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section id="intro" class="reveal" data-theme="dark">
    <div class="slide-inner">
      <img class="portrait" src="/images/minh.jpeg" alt="Minh Tran — Machine Learning Engineer, Vaisala Xweather" />
      <h1 class="name">Minh Tran</h1>
      <p class="role">Machine Learning Engineer, Xweather Labs @ Vaisala Xweather</p>
      <p class="hook">
        I love being bossy to computers and have been doing so for a few years.
        It turns out that computers are quite smart and (un)willing to learn, so
        I study computer pedagogy.
      </p>
      <a class="cta scroll-cue" href="#about">Scroll to explore ↓</a>
    </div>
  </section>

  <section id="about" class="reveal">
    <div class="slide-inner">
      <span class="section-number">02</span>
      <h2 class="title">About</h2>
      <p>I don't just use machines, I like to know how they want to work. I combine
        classical ML with a little bit of everything else, and I try to stay as close
        to the mechanism as I can.</p>
      <p>From deep learning to privacy-preserving audio, the through line is always the
        same: figure out how it actually functions, then decide whether it deserves to
        stay in your inbox.</p>
      <a class="cta" href="#experience">See my work →</a>
      <div class="socials">
        <a href="https://github.com/minhtran0610" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/minhtran0610" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://orcid.org/0000-0003-4637-6081" target="_blank" rel="noopener noreferrer">ORCID</a>
      </div>
    </div>
  </section>

  <section id="experience" class="reveal">
    <div class="slide-inner">
      <span class="section-number">03</span>
      <h2 class="title">Experience</h2>
      <ul class="timeline">
        <li class="timeline-item">
          <p class="role">Machine Learning Engineer, Vaisala Xweather</p>
          <p class="dates">Feb 2026-present</p>
          <p class="description">Point weather forecasting with classical ML (XGBoost,
            scikit-learn), contributing to long-term ML/AI prediction capability.</p>
          <ul class="tags">
            <li class="tag">XGBoost</li>
            <li class="tag">scikit-learn</li>
            <li class="tag">Classical ML</li>
          </ul>
        </li>
        <li class="timeline-item">
          <p class="role">Junior Deep Learning Engineer, Vaisala Xweather</p>
          <p class="dates">Jun 2025-Feb 2026</p>
          <p class="description">Inference and visualization pipelines for a
            transformer-based, multi-head precipitation model. 20% inference latency
            reduction via PyTorch/TensorRT model compilation.</p>
          <ul class="tags">
            <li class="tag">PyTorch</li>
            <li class="tag">TensorRT</li>
            <li class="tag">Transformers</li>
          </ul>
        </li>
        <li class="timeline-item">
          <p class="role">Thesis Worker, CIVIT (Tampere)</p>
          <p class="dates">Oct 2024-Dec 2025</p>
          <p class="description">Implemented Gaussian splatting for a volumetric
            capture studio.</p>
          <ul class="tags">
            <li class="tag">Gaussian Splatting</li>
            <li class="tag">3D Reconstruction</li>
          </ul>
        </li>
        <li class="timeline-item">
          <p class="role">Data Scientist, Kempower</p>
          <p class="dates">May 2023-Oct 2024</p>
          <p class="description">Cloud-based data science for EV charging
            infrastructure.</p>
          <ul class="tags">
            <li class="tag">Data Science</li>
            <li class="tag">Cloud</li>
            <li class="tag">EV Charging</li>
          </ul>
        </li>
        <li class="timeline-item">
          <p class="role">Research Assistant, Tampere University</p>
          <p class="dates">2021-2023</p>
          <p class="description">Arrowhead/MQTT service integration (David Hästbacka);
            adversarial learning for privacy-preserving audio representations (Tuomas
            Virtanen's Audio Research Group), the basis for 2 of the 3 papers listed
            and the BSc thesis.</p>
          <ul class="tags">
            <li class="tag">MQTT</li>
            <li class="tag">Adversarial Learning</li>
            <li class="tag">Audio ML</li>
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <section id="projects" class="reveal">
    <div class="slide-inner">
      <span class="section-number">04</span>
      <h2 class="title">Work on the side</h2>
      <!--
        TODO(opencode): replace this comment with 4 literal
        <li class="timeline-item"> blocks from CONTENT.md's "## Projects"
        section, in the order listed there (World Cup, Context-Window
        Demo, Jarvis, Home Lab). Same markup shape as Experience above,
        but order within each item is title -> description -> CTA link
        -> tags (CTA before tags, not after):
          <li class="timeline-item">
            <p class="role">{title}</p>
            <p class="description">{Hook + What it does folded together}</p>
            <a class="cta" href="{link}" target="_blank" rel="noopener noreferrer">View code →</a>
            <ul class="tags"><li class="tag">{Stack item}</li>...</ul>
          </li>
        Exceptions (see CONTENT.md's rendering note):
        - Jarvis: no <a class="cta">, add a small
          <span class="tag">Paused</span> inline next to the title instead.
          It still gets a <ul class="tags"> row from its Stack line.
        - Home Lab: no <ul class="tags"> at all. Its CTA is
          <a class="cta" href="#lightbox-rack">View photo →</a> — this
          opens the pure-CSS lightbox already built into this page
          (see #lightbox-rack near the bottom), do not build a new one.
      -->
    </div>
  </section>

  <section id="off" class="reveal">
    <div class="slide-inner">
      <span class="section-number">05</span>
      <h2 class="title">Off the clock</h2>
      <ul class="tags">
        <li class="tag">Driving, not taxiing</li>
        <li class="tag">Time outdoors</li>
        <li class="tag">Sports</li>
        <li class="tag">Travel</li>
      </ul>
      <p>The same instinct that runs the home lab, staying close to the mechanism
        instead of behind a layer of abstraction, shows up outside of tech too.</p>
    </div>
  </section>

  <section id="education" class="reveal">
    <div class="slide-inner">
      <span class="section-number">06</span>
      <h2 class="title">Education</h2>
      <ul class="timeline">
        <li class="timeline-item">
          <p class="role">M.Sc., Signal Processing & Machine Learning, Tampere University</p>
          <p class="dates">2023-2025</p>
          <p class="card-sub">Thesis: <a href="https://urn.fi/URN:NBN:fi:tuni-2025122212070">Automated Matting and Gaussian Splatting toward High-Fidelity Volumetric Performance Capture</a></p>
        </li>
        <li class="timeline-item">
          <p class="role">B.Sc., Science and Engineering, Tampere University</p>
          <p class="dates">2020-2023</p>
          <p class="card-sub">Thesis: <a href="https://urn.fi/URN:NBN:fi:tuni-202304254453">Learning privacy-preserving representation of audio data with adversarial learning</a></p>
        </li>
        <li class="timeline-item">
          <p class="role">Hanoi-Amsterdam High School for the Gifted (Chemistry)</p>
          <p class="dates">2017-2020</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="publications" class="reveal">
    <div class="slide-inner">
      <span class="section-number">07</span>
      <h2 class="title">Publications</h2>
      <ul class="articles">
        <li>
          <a href="https://doi.org/10.1109/IECON51785.2023.10311779" target="_blank" rel="noopener noreferrer">External Token-Based Authorization of Data-Driven Integrations and Service Compositions in MQTT 5.</a>
          <span class="venue">IECON 2023.</span>
        </li>
        <li>
          <a href="https://doi.org/10.1109/OJSP.2023.3349113" target="_blank" rel="noopener noreferrer">Adversarial Representation Learning for Robust Privacy Preservation in Audio.</a>
          <span class="venue">IEEE Open Journal of Signal Processing, 2024.</span>
        </li>
        <li>
          <a href="https://arxiv.org/abs/2308.04960" target="_blank" rel="noopener noreferrer">Representation Learning for Audio Privacy Preservation Using Source Separation and Robust Adversarial Learning.</a>
        </li>
      </ul>
    </div>
  </section>

  <footer class="reveal">
    <div class="slide-inner">
      <p class="subtitle">Self-hosting by day, overclocking theory by night.</p>
      <a class="big-email" href="mailto:minhtran0610@gmail.com">minhtran0610@gmail.com</a>
      <div class="socials">
        <a href="https://github.com/minhtran0610" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/minhtran0610" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://orcid.org/0000-0003-4637-6081" target="_blank" rel="noopener noreferrer">ORCID</a>
      </div>
      <p class="copyright">© 2026 Minh Tran.</p>
    </div>
  </footer>

  <div id="lightbox-rack" class="lightbox">
    <a class="lightbox-backdrop" href="#projects" aria-label="Close photo"></a>
    <img src="/images/pc_rack.jpg" alt="Home lab, three-node Proxmox cluster on a metal shelf" />
    <a class="lightbox-close" href="#projects" aria-label="Close photo">
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </a>
  </div>
</Layout>
